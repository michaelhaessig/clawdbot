# Dockerfile for self-updating HA addon
# This creates a bootstrap image with build tools - clawdbot is installed at runtime
#
# The addon will clone and build clawdbot on first start, storing it in persistent
# storage (/config/clawdbot-app). Updates happen automatically without container rebuild.

ARG BUILD_FROM=ghcr.io/home-assistant/amd64-base-debian:bookworm
FROM ${BUILD_FROM}

# Install ALL dependencies (runtime + build tools for self-updating)
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Build tools for native modules (sharp/libvips)
    python3 \
    make \
    g++ \
    # libvips for image processing
    libvips-dev \
    libvips42 \
    # Version control for cloning and updates
    git \
    # Network and utilities
    curl \
    ca-certificates \
    unzip \
    xxd \
    lsof \
    wget \
    # Skill dependencies
    jq \
    ffmpeg \
    sqlite3 \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 22 via nodesource (HA base only has Node 18, we need 22 for regex /v flag)
ARG NODE_VERSION=22
RUN curl -fsSL https://deb.nodesource.com/setup_${NODE_VERSION}.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Enable corepack for pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Install bun (required for some build scripts)
RUN curl -fsSL https://bun.sh/install | bash
ENV PATH="/root/.bun/bin:$PATH"

# Install Go (for Go-based addon tools)
ARG GO_VERSION=1.23.4
RUN curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-$(dpkg --print-architecture).tar.gz" | tar -C /usr/local -xzf -
ENV PATH="/usr/local/go/bin:$PATH"

# Install uv (Python package manager for skills like local-places, nano-banana-pro)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"

# Install gog CLI (Google Workspace: Gmail, Calendar, Drive, Contacts, Sheets, Docs)
ARG GOG_VERSION=0.4.2
RUN ARCH=$(dpkg --print-architecture | sed 's/aarch64/arm64/;s/x86_64/amd64/') \
    && curl -fsSL "https://github.com/steipete/gogcli/releases/download/v${GOG_VERSION}/gogcli_${GOG_VERSION}_linux_${ARCH}.tar.gz" \
    | tar xz -C /usr/local/bin gog \
    && chmod +x /usr/local/bin/gog

# Install goplaces CLI (Google Places API search)
ARG GOPLACES_VERSION=0.2.0
RUN ARCH=$(dpkg --print-architecture | sed 's/aarch64/arm64/;s/x86_64/amd64/') \
    && curl -fsSL "https://github.com/steipete/goplaces/releases/download/v${GOPLACES_VERSION}/goplaces_${GOPLACES_VERSION}_linux_${ARCH}.tar.gz" \
    | tar xz -C /usr/local/bin goplaces \
    && chmod +x /usr/local/bin/goplaces

# Install sag CLI (ElevenLabs TTS) - AMD64 only, no ARM64 build available
ARG SAG_VERSION=0.2.1
RUN ARCH=$(dpkg --print-architecture) \
    && if [ "$ARCH" = "amd64" ]; then \
        curl -fsSL "https://github.com/steipete/sag/releases/download/v${SAG_VERSION}/sag_${SAG_VERSION}_linux_amd64.tar.gz" \
        | tar xz -C /usr/local/bin sag \
        && chmod +x /usr/local/bin/sag; \
    else \
        echo "sag: skipping install (no ARM64 build available)"; \
    fi

# Copy startup script and build helper
COPY clawdbot-gateway/run.sh /run.sh
COPY clawdbot-gateway/build-tools.sh /opt/build-tools.sh
RUN chmod +x /run.sh /opt/build-tools.sh

# Create addon directories (may be empty)
RUN mkdir -p /opt/addon-tools /opt/addon-skills

# Copy addon-specific tools if they exist (each tool is a subdirectory)
# Tools are built into binaries at image build time
COPY clawdbot-gateway/tools/ /opt/addon-tools/

# Copy addon-bundled skills if they exist (each skill is a subdirectory)
# Skills are installed to managed skills dir at runtime
COPY clawdbot-gateway/skills/ /opt/addon-skills/

# Build addon tools (supports TypeScript/bun, Go, and pre-built binaries)
RUN /opt/build-tools.sh

ENV NODE_ENV=production
ENV CLAWDBOT_APP_DIR=/config/clawdbot-app
ENV CLAWDBOT_STATE_DIR=/config/clawdbot

# Working directory will be set by run.sh after installation
WORKDIR /config

CMD ["/run.sh"]
