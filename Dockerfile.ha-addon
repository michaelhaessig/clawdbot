# Dockerfile for GitHub Actions builds (context = full repo)
# For local HA builds, see clawdbot-gateway/Dockerfile

# Global ARG for runtime base image (must be before FROM to use in FROM)
ARG BUILD_FROM=ghcr.io/home-assistant/amd64-base-debian:bookworm

# Build stage - use Debian to match runtime (glibc compatibility)
FROM node:22-bookworm-slim AS builder

# Install build dependencies for native modules
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    make \
    g++ \
    libvips-dev \
    bash \
    curl \
    unzip \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install bun (required for build scripts)
RUN curl -fsSL https://bun.sh/install | bash
ENV PATH="/root/.bun/bin:$PATH"

RUN corepack enable

WORKDIR /app

# Copy dependency files first for better caching
COPY package.json pnpm-lock.yaml ./
COPY patches ./patches
COPY scripts ./scripts

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source and build
COPY src ./src
COPY tsconfig.json ./
COPY ui ./ui
COPY tools ./tools

RUN pnpm build
RUN pnpm ui:install
RUN pnpm ui:build

# Build hac CLI
RUN cd tools/hac && bun build src/index.ts --outfile=dist/index.js --target=node --minify

# Prune dev dependencies
RUN pnpm prune --prod

# Runtime stage - uses global ARG BUILD_FROM
FROM ${BUILD_FROM}

# Install Node.js and runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    nodejs \
    npm \
    libvips42 \
    xxd \
    lsof \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy built application from builder
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./

# Copy hac CLI and make it available in PATH
COPY --from=builder /app/tools/hac/dist/index.js /usr/local/bin/hac.js
RUN printf '#!/bin/sh\nexec node /usr/local/bin/hac.js "$@"\n' > /usr/local/bin/hac && chmod +x /usr/local/bin/hac

# Copy run script
COPY clawdbot-gateway/run.sh /run.sh
RUN chmod a+x /run.sh

ENV NODE_ENV=production

CMD ["/run.sh"]
