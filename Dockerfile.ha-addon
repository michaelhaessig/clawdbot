# Dockerfile for HA addon with pre-built openclaw app
# Stage 1 builds openclaw from source in CI (plenty of disk/CPU).
# Stage 2 copies the built artifacts into the HA runtime image.
# This avoids building on-device, which exhausts the 28 GB eMMC on HA Green.

# Global ARG so it's available to the second FROM via --build-arg
ARG BUILD_FROM=ghcr.io/home-assistant/amd64-base-debian:bookworm

# === Stage 1: Build openclaw ===
FROM node:22-bookworm AS builder
ENV CI=true
WORKDIR /app
COPY . .
RUN corepack enable && corepack prepare pnpm@latest --activate
RUN pnpm install --frozen-lockfile
# Build may have non-fatal DTS/type-check errors on feature branches;
# the JS bundle (dist/index.js) is produced by tsdown before those steps.
RUN pnpm build || true
RUN test -f dist/index.js || { echo "ERROR: dist/index.js not produced by build"; exit 1; }
RUN pnpm ui:install && pnpm ui:build
# Remove dev deps to shrink the final image
RUN pnpm prune --prod

# === Stage 2: Runtime image ===
FROM ${BUILD_FROM}

# Install ALL dependencies (runtime + build tools for self-updating)
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Build tools for native modules (sharp/libvips)
    python3 \
    make \
    g++ \
    # libvips for image processing
    libvips-dev \
    libvips42 \
    # Version control for cloning and updates
    git \
    # Network and utilities
    curl \
    ca-certificates \
    unzip \
    xxd \
    lsof \
    wget \
    # Network diagnostics
    iputils-ping \
    nmap \
    # Wake-on-LAN (wake remote machines like Mac for browser automation)
    wakeonlan \
    etherwake \
    # Skill dependencies
    jq \
    ffmpeg \
    sqlite3 \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 22 via nodesource (HA base only has Node 18, we need 22 for regex /v flag)
ARG NODE_VERSION=22
RUN curl -fsSL https://deb.nodesource.com/setup_${NODE_VERSION}.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Enable corepack for pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Install bun (required for some build scripts)
RUN curl -fsSL https://bun.sh/install | bash
ENV PATH="/root/.bun/bin:$PATH"

# Install Go (for Go-based addon tools)
ARG GO_VERSION=1.23.4
RUN curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-$(dpkg --print-architecture).tar.gz" | tar -C /usr/local -xzf -
ENV PATH="/usr/local/go/bin:$PATH"

# Install uv (Python package manager for skills like local-places, nano-banana-pro)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"

# Install gog CLI (Google Workspace: Gmail, Calendar, Drive, Contacts, Sheets, Docs)
ARG GOG_VERSION=0.7.0
RUN ARCH=$(dpkg --print-architecture | sed 's/aarch64/arm64/;s/x86_64/amd64/') \
    && curl -fsSL "https://github.com/steipete/gogcli/releases/download/v${GOG_VERSION}/gogcli_${GOG_VERSION}_linux_${ARCH}.tar.gz" \
    | tar xz -C /usr/local/bin gog \
    && chmod +x /usr/local/bin/gog

# Install goplaces CLI (Google Places API search)
ARG GOPLACES_VERSION=0.2.0
RUN ARCH=$(dpkg --print-architecture | sed 's/aarch64/arm64/;s/x86_64/amd64/') \
    && curl -fsSL "https://github.com/steipete/goplaces/releases/download/v${GOPLACES_VERSION}/goplaces_${GOPLACES_VERSION}_linux_${ARCH}.tar.gz" \
    | tar xz -C /usr/local/bin goplaces \
    && chmod +x /usr/local/bin/goplaces

# Install sag CLI (ElevenLabs TTS) - AMD64 only, no ARM64 build available
ARG SAG_VERSION=0.2.1
RUN ARCH=$(dpkg --print-architecture) \
    && if [ "$ARCH" = "amd64" ]; then \
        curl -fsSL "https://github.com/steipete/sag/releases/download/v${SAG_VERSION}/sag_${SAG_VERSION}_linux_amd64.tar.gz" \
        | tar xz -C /usr/local/bin sag \
        && chmod +x /usr/local/bin/sag; \
    else \
        echo "sag: skipping install (no ARM64 build available)"; \
    fi

# Install Gemini CLI (Google's AI agent for terminal)
RUN npm install -g @google/gemini-cli

# Install Playwright with bundled Chromium for browser automation
# This installs both the browser and required system dependencies (libs, fonts)
# NOTE: Commented out - using remote Mac for browser automation instead
# ENV PLAYWRIGHT_BROWSERS_PATH=/opt/playwright-browsers
# RUN bunx playwright install --with-deps chromium

# Copy startup script and build helper
COPY clawdbot-gateway/run.sh /run.sh
COPY clawdbot-gateway/build-tools.sh /opt/build-tools.sh
RUN chmod +x /run.sh /opt/build-tools.sh

# Create addon directories (may be empty)
RUN mkdir -p /opt/addon-tools

# Copy addon-specific tools if they exist (each tool is a subdirectory)
# Tools are built into binaries at image build time
COPY clawdbot-gateway/tools/ /opt/addon-tools/

# Build addon tools (supports TypeScript/bun, Go, and pre-built binaries)
RUN /opt/build-tools.sh

# Copy pre-built openclaw app from builder stage
# dist/ includes control-ui (vite builds to dist/control-ui/)
COPY --from=builder /app/dist /opt/openclaw-app/dist
COPY --from=builder /app/node_modules /opt/openclaw-app/node_modules
COPY --from=builder /app/package.json /opt/openclaw-app/package.json
# Workspace templates needed at runtime for agent workspace scaffolding
COPY --from=builder /app/docs/reference/templates /opt/openclaw-app/docs/reference/templates
# Extension source needed: some bundled extensions (e.g. mattermost) have
# specifiers like ./src/channel.js that jiti resolves from .ts at runtime.
# These resolve relative to dist/extensions/<name>/, so copy source there.
COPY --from=builder /app/extensions /opt/openclaw-app/dist/extensions-src
RUN cd /opt/openclaw-app/dist/extensions && \
    for ext in */; do \
        ext_name="${ext%/}"; \
        if [ -d "/opt/openclaw-app/dist/extensions-src/${ext_name}/src" ]; then \
            cp -a "/opt/openclaw-app/dist/extensions-src/${ext_name}/src" "${ext_name}/src"; \
        fi; \
    done && \
    rm -rf /opt/openclaw-app/dist/extensions-src

ENV NODE_ENV=production
ENV CLAWDBOT_APP_DIR=/config/clawdbot-app
ENV CLAWDBOT_STATE_DIR=/config/clawdbot
ENV HOME=/config/clawdbot
# Playwright browser location (commented out - using remote Mac)
# ENV PLAYWRIGHT_BROWSERS_PATH=/opt/playwright-browsers

# Working directory will be set by run.sh after installation
WORKDIR /config

CMD ["/run.sh"]
