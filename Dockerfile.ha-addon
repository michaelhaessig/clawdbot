# Dockerfile for GitHub Actions builds (context = full repo)
# For local HA builds, see clawdbot-gateway/Dockerfile

# Global ARG for runtime base image (must be before FROM to use in FROM)
ARG BUILD_FROM=ghcr.io/home-assistant/amd64-base:3.19

# Build stage - use Alpine to match runtime
FROM node:22-alpine AS builder

# Install build dependencies for native modules
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    vips-dev

RUN corepack enable

WORKDIR /app

# Copy dependency files first for better caching
COPY package.json pnpm-lock.yaml ./
COPY patches ./patches

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source and build
COPY src ./src
COPY scripts ./scripts
COPY tsconfig.json ./
COPY ui ./ui

RUN pnpm build
RUN pnpm ui:install
RUN pnpm ui:build

# Prune dev dependencies
RUN pnpm prune --prod

# Runtime stage - uses global ARG BUILD_FROM
FROM ${BUILD_FROM}

# Install Node.js and runtime dependencies
RUN apk add --no-cache \
    nodejs \
    npm \
    vips \
    xxd \
    lsof \
    curl

WORKDIR /app

# Copy built application from builder
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./

# Copy run script
COPY clawdbot-gateway/run.sh /run.sh
RUN chmod a+x /run.sh

ENV NODE_ENV=production

CMD ["/run.sh"]
