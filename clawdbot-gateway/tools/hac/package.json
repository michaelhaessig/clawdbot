{
  "name": "hac",
  "version": "0.1.0",
  "description": "Home Assistant CLI for controlling devices via the Supervisor/REST API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "hac": "dist/index.js"
  },
